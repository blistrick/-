---
import { Picture } from 'astro:assets';
import poster from '../../images/facade-corner-sky.jpg';
const steps = [
  { t: 'Две секции, 9–14 этажей', d: 'Г-образный объём вдоль улиц Е-69 и Бектурова. Въезд на парковку с Бектурова.' },
  { t: 'Стекло и ламели', d: 'Панорамное остекление офисных этажей, светлые вертикальные ламели на венце.' },
  { t: 'Каменный подиум', d: 'Первый этаж высотой 4,5 м: витрины и отдельные входы в коммерческие помещения.' },
];
---
<section class="model on-night" id="model" aria-labelledby="model-title" data-model>
  <div class="model__track" data-model-track>
    <div class="model__stage">
      <div class="model__sky model__sky--day" aria-hidden="true"></div>
      <div class="model__sky model__sky--night" aria-hidden="true" data-model-night></div>
      <div class="model__poster" data-model-poster>
        <Picture
          src={poster}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 60vw"
          alt="Бизнес-центр CAPITAL: угловой ракурс на фоне неба"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="model__canvas" data-model-canvas aria-hidden="true"></div>

      <div class="model__copy wrap">
        <h2 id="model-title" class="model__title">Здание целиком</h2>
        <ol class="model__steps">
          {steps.map((s, i) => (
            <li class="model__step" data-model-step={i}>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
        <p class="model__note">Объёмная модель упрощена и построена по планам и визуализациям.</p>
      </div>
      <div class="model__progress" aria-hidden="true"><span data-model-progress></span></div>
    </div>
  </div>
</section>

<style>
  .model {
    position: relative;
    background: var(--night-950);
  }
  .model__track {
    position: relative;
    height: 320vh;
  }
  .model__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .model__sky {
    position: absolute;
    inset: 0;
    z-index: -3;
  }
  .model__sky--day {
    background: radial-gradient(120% 80% at 70% 20%, #3b5583 0%, #22345a 45%, #121a2e 100%);
  }
  .model__sky--night {
    background: radial-gradient(120% 80% at 70% 20%, #1c2541 0%, #0f1628 50%, #080c16 100%);
    opacity: 0;
  }
  .model__poster {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(62vw, 64rem);
    z-index: -2;
    transition: opacity 0.9s var(--ease-out);
  }
  .model__poster :global(picture),
  .model__poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .model__poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--night-950) 0%, rgb(12 18 32 / 0) 45%);
  }
  .model__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .model.is-3d .model__canvas {
    opacity: 1;
  }
  .model.is-3d .model__poster {
    opacity: 0;
  }
  .model__canvas :global(canvas) {
    width: 100% !important;
    height: 100% !important;
  }
  .model__copy {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    pointer-events: none;
  }
  .model__title {
    max-width: 8ch;
  }
  .model__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 24rem;
  }
  .model__step {
    grid-area: 1 / 1;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-on-night);
  }
  .model__step + .model__step {
    opacity: 0;
  }
  .model__step p {
    margin-top: 0.75rem;
    color: var(--ink-on-night-2);
  }
  .model__note {
    position: absolute;
    bottom: 2rem;
    font-size: var(--step--1);
    color: var(--ink-on-night-2);
  }
  .model__progress {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    width: 1px;
    height: 32vh;
    transform: translateY(-50%);
    background: var(--rule-on-night);
  }
  .model__progress span {
    position: absolute;
    inset: 0;
    background: var(--amber);
    transform: scaleY(0);
    transform-origin: top;
  }

  /* static presentation: no JS, reduced motion, or a device that gets the render instead of WebGL */
  :global(html:not(.motion)) .model__track {
    height: auto;
  }
  :global(html:not(.motion)) .model__stage {
    position: relative;
    height: auto;
    min-height: 100svh;
  }
  :global(html:not(.motion)) .model__copy {
    padding-block: var(--section-y);
  }
  :global(html:not(.motion)) .model__step {
    grid-area: auto;
    opacity: 1 !important;
  }
  :global(html:not(.motion)) .model__steps {
    gap: 2rem;
  }
  :global(html:not(.motion)) .model__progress {
    display: none;
  }
  :global(html:not(.motion)) .model__note {
    position: static;
  }

  @media (max-width: 900px) {
    .model__track {
      height: 260vh;
    }
    .model__poster {
      width: 100%;
      opacity: 0.55;
    }
    .model__poster::after {
      background: linear-gradient(0deg, var(--night-950) 10%, rgb(12 18 32 / 0.2) 70%);
    }
    .model__copy {
      justify-content: flex-end;
      padding-bottom: 5rem;
    }
    .model__title {
      position: absolute;
      top: 6.5rem;
    }
    .model__progress {
      display: none;
    }
  }
</style>
