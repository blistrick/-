---
import { Picture, getImage } from 'astro:assets';
import sky from '../../images/facade-sky.jpg';
import reception from '../../images/lobby-reception.jpg';
import corner from '../../images/facade-corner-day.jpg';
import officeOpen from '../../images/office-open.jpg';
import corridor from '../../images/corridor.jpg';
import partition from '../../images/office-partition.jpg';
import dusk from '../../images/facade-dusk-square.jpg';
import entrance from '../../images/lobby-entrance.jpg';
import commercial from '../../images/interior-commercial.jpg';
import crossroad from '../../images/facade-crossroad.jpg';

const shots = [
  { img: sky, alt: 'Фасад бизнес-центра CAPITAL на фоне синего неба', cap: 'Фасад' },
  { img: reception, alt: 'Ресепшен в лобби', cap: 'Лобби' },
  { img: corner, alt: 'Угол здания с витринами первого этажа днём', cap: 'Подиум и витрины' },
  { img: officeOpen, alt: 'Офис открытой планировки с панорамными окнами', cap: 'Офис в чистовой отделке' },
  { img: corridor, alt: 'Коридор офисного этажа со стеклянными перегородками', cap: 'Коридор офисного этажа' },
  { img: partition, alt: 'Офис со стеклянной перегородкой и ковровым покрытием', cap: 'Офисное помещение' },
  { img: dusk, alt: 'Бизнес-центр CAPITAL в сумерках', cap: 'Вечер' },
  { img: entrance, alt: 'Вход в лобби с высокими витражами', cap: 'Вход в лобби' },
  { img: commercial, alt: 'Коммерческое помещение с колоннами и витражами', cap: 'Коммерческое помещение' },
  { img: crossroad, alt: 'Бизнес-центр на перекрёстке', cap: 'Фасад с перекрёстка' },
];
const large = await Promise.all(shots.map((s) => getImage({ src: s.img, width: Math.min(2000, s.img.width), format: 'webp' })));
---
<section class="gallery on-stone" id="gallery" aria-labelledby="gallery-title" data-gallery>
  <div class="gallery__track-wrap" data-gallery-pin>
    <div class="gallery__inner">
      <div class="wrap gallery__head">
        <h2 id="gallery-title" data-reveal>Галерея</h2>
        <p class="muted gallery__note">Визуализации проекта. Нажмите на кадр, чтобы открыть крупно.</p>
      </div>
      <ul class="gallery__track" data-gallery-track>
        {shots.map((s, i) => (
          <li class="shot" style={`--ar:${s.img.width / s.img.height}`}>
            <button type="button" class="shot__btn" data-shot={i} data-full={large[i].src} data-alt={s.alt} aria-label={`Открыть: ${s.cap}`}>
              <Picture
                src={s.img}
                formats={['avif', 'webp']}
                widths={[480, 720, 960, 1280]}
                sizes="(max-width: 700px) 80vw, 46vh"
                alt={s.alt}
                loading="lazy"
                decoding="async"
              />
            </button>
            <p class="shot__cap">{s.cap}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Просмотр изображения">
    <img data-lightbox-img src={large[0].src} alt={shots[0].alt} width={large[0].attributes.width} height={large[0].attributes.height} loading="lazy" decoding="async" />
    <div class="lightbox__bar">
      <p class="lightbox__count num" data-lightbox-count></p>
      <div class="lightbox__nav">
        <button type="button" data-lightbox-prev aria-label="Предыдущее изображение">
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M17 10H4M9 4.5 3.5 10 9 15.5" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <button type="button" data-lightbox-next aria-label="Следующее изображение">
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <button type="button" data-lightbox-close aria-label="Закрыть">
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 4 12 12M16 4 4 16" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
      </div>
    </div>
  </dialog>
</section>

<style>
  .gallery {
    position: relative;
    padding-top: var(--section-y);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    overflow: clip;
  }
  .gallery__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .gallery__note {
    font-size: var(--step--1);
    max-width: 36ch;
  }
  .gallery__track {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    display: flex;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .shot {
    flex: none;
    scroll-snap-align: start;
    height: min(56vh, 40rem);
    aspect-ratio: var(--ar);
    max-width: 82vw;
  }
  .shot__btn {
    display: block;
    width: 100%;
    height: calc(100% - 2.25rem);
    padding: 0;
    border: 0;
    background: var(--stone-200);
    overflow: hidden;
    cursor: zoom-in;
  }
  .shot__btn :global(picture),
  .shot__btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .shot__btn:hover :global(img) {
      transform: scale(1.035);
    }
  }
  .shot__cap {
    padding-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-on-stone-2);
  }

  /* desktop: vertical scroll drives the strip sideways (transform only) */
  :global(html.motion) .gallery.is-pinned .gallery__track {
    overflow: visible;
    scroll-snap-type: none;
    will-change: transform;
  }
  :global(html.motion) .gallery.is-pinned .gallery__track-wrap {
    height: var(--pin-h, 300vh);
  }
  :global(html.motion) .gallery.is-pinned .gallery__inner {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lightbox {
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 3vw, 2.5rem);
    border: 0;
    background: rgb(8 12 22 / 0.96);
    color: var(--ink-on-night);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }
  .lightbox::backdrop {
    background: rgb(8 12 22 / 0.6);
  }
  .lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    min-height: 0;
  }
  .lightbox__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .lightbox__count {
    font-size: var(--step--1);
    color: var(--ink-on-night-2);
  }
  .lightbox__nav {
    display: flex;
    gap: 0.5rem;
  }
  .lightbox__nav button {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--rule-on-night);
    background: none;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-out);
  }
  .lightbox__nav button:hover {
    border-color: var(--amber);
  }
</style>
