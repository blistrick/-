---
// The supplied orbit video plays on its own as a seamless forward-and-back loop.
import { getImage } from 'astro:assets';
import posterSrc from '../../images/tour-poster.jpg';
const poster = await getImage({ src: posterSrc, width: 960, format: 'webp', quality: 72 });
const steps = [
  { t: 'Две секции, 9–14 этажей', d: 'Г-образный объём вдоль улиц Е-69 и Бектурова. Въезд на парковку с Бектурова.' },
  { t: 'Стекло и ламели', d: 'Панорамное остекление офисных этажей, светлые вертикальные ламели на венце.' },
  { t: 'Каменный подиум', d: 'Первый этаж высотой 4,5 м: витрины и отдельные входы в коммерческие помещения.' },
];
---
<section class="tour on-night" id="tour" aria-labelledby="tour-title" data-tour>
  <div class="tour__media" data-tour-media>
    <video
      class="tour__video"
      data-tour-video
      data-src-desktop="/video/capital-tour-loop-960.mp4"
      data-src-mobile="/video/capital-tour-loop-640.mp4"
      poster={poster.src}
      width="960"
      height="960"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      aria-label="Облёт бизнес-центра CAPITAL: вид со всех сторон"
    ></video>
  </div>

  <div class="tour__copy wrap">
    <h2 id="tour-title" class="tour__title" data-reveal>Здание со&nbsp;всех сторон</h2>
    <ol class="tour__steps" data-reveal-group>
      {steps.map((s) => (
        <li class="tour__step" data-reveal-item>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
    <p class="tour__note">Видео: визуализация проекта.</p>
  </div>
</section>

<style>
  .tour {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background: var(--night-950);
  }
  .tour__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(66vw, 110svh);
    z-index: -1;
    overflow: hidden;
    /* the frame dissolves into the night ground: no visible edge or seam */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 5%, #000 38%), linear-gradient(0deg, transparent 0%, transparent 3%, #000 20%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0%, transparent 5%, #000 38%), linear-gradient(0deg, transparent 0%, transparent 3%, #000 20%);
    mask-composite: intersect;
  }
  .tour__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .tour__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: var(--section-y);
  }
  .tour__title {
    max-width: 9ch;
  }
  .tour__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
    max-width: 24rem;
  }
  .tour__step {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-on-night);
  }
  .tour__step p {
    margin-top: 0.6rem;
    color: var(--ink-on-night-2);
  }
  .tour__note {
    font-size: var(--step--1);
    color: var(--ink-on-night-2);
  }

  @media (max-width: 900px) {
    .tour {
      display: block;
      min-height: 0;
    }
    .tour__media {
      position: relative;
      inset: auto;
      width: 100%;
      aspect-ratio: 1;
      -webkit-mask-image: linear-gradient(0deg, transparent 0%, transparent 4%, #000 30%);
      mask-image: linear-gradient(0deg, transparent 0%, transparent 4%, #000 30%);
    }
    .tour__copy {
      margin-top: -4rem;
      padding-top: 0;
      gap: 1.75rem;
    }
    .tour__title {
      max-width: none;
    }
  }
</style>
