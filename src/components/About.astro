---
import { Picture } from 'astro:assets';
import front from '../../images/facade-day-front.jpg';
import Fill from './Fill.astro';
import { facts } from '../data/site';
const rows: { k: string; v: string | null; hint?: string }[] = [
  { k: 'Расположение', v: 'Левый берег, первая линия ул. Бектурова, рядом с ТРЦ «Хан Шатыр»' },
  { k: 'Класс', v: facts.buildingClass, hint: 'Класс бизнес-центра' },
  { k: 'Этажность', v: `${facts.floors} этажей, ${facts.sections} секции` },
  { k: 'Высота потолков', v: `${facts.ceilingGround} на первом этаже, ${facts.ceilingTypical} на офисных` },
  { k: 'Отделка', v: 'Чистовая на офисных этажах, черновая в коммерции первого этажа' },
  { k: 'Площади', v: `Офисы от ${facts.minArea} м², коммерция от 68,51 м²` },
  { k: 'Общая площадь', v: facts.totalArea, hint: 'Общая площадь здания' },
  { k: 'Сдача', v: facts.handover },
  { k: 'Условия', v: facts.terms },
  { k: 'Эксплуатация', v: facts.management },
];
---
<section class="about on-stone section" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__intro">
      <h2 id="about-title" data-reveal>Рядом с&nbsp;Хан Шатыром, на&nbsp;выезде к&nbsp;проспекту Туран</h2>
      <p class="about__text" data-reveal>
        CAPITAL — две секции из стекла и светлого камня на первой линии Бектурова. Офисы сдаются в чистовой
        отделке: заезжаете и работаете. На первом этаже помещения с отдельными входами для магазинов,
        ресторанов и шоурумов.
      </p>
    </div>
    <dl class="spec" data-reveal-group>
      {rows.map((r) => (
        <div class="spec__row" data-reveal-item>
          <dt>{r.k}</dt>
          <dd class="num"><Fill value={r.v} hint={r.hint} /></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<figure class="bleed" aria-label="Фасад бизнес-центра днём">
  <div class="bleed__frame">
    <div class="bleed__media" data-parallax="0.12">
      <Picture
        src={front}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 1920, 2400]}
        sizes="100vw"
        alt="Бизнес-центр CAPITAL днём: две башни с остеклённым фасадом и светлыми ламелями на венце"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
  <figcaption class="wrap bleed__cap">Фасад со стороны улицы Бектурова. Визуализация</figcaption>
</figure>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: start;
  }
  .about__intro {
    position: sticky;
    top: 7rem;
  }
  .about__text {
    max-width: 44ch;
    margin-top: 2rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-on-stone-2);
  }
  .spec {
    margin: 0;
    border-top: 1px solid var(--ink-on-stone);
  }
  .spec__row {
    display: grid;
    grid-template-columns: minmax(8rem, 2fr) 5fr;
    gap: 1.5rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--rule);
  }
  .spec dt {
    font-size: var(--step--1);
    color: var(--ink-on-stone-2);
    padding-top: 0.15rem;
  }
  .spec dd {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.45;
  }
  .bleed {
    margin: 0;
    background: var(--stone-100);
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .bleed__frame {
    position: relative;
    height: clamp(26rem, 82vh, 58rem);
    overflow: hidden;
  }
  .bleed__media {
    position: absolute;
    inset: -12% 0;
    will-change: transform;
  }
  .bleed__media :global(picture),
  .bleed__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bleed__cap {
    padding-top: 0.9rem;
    font-size: var(--step--1);
    color: var(--ink-on-stone-2);
  }
  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__intro {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .spec__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
