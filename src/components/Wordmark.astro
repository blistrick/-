---
import wm from '../data/wordmark.json';
interface Props { class?: string; label?: boolean }
const { class: cls, label = true } = Astro.props;
---
<svg
  class={cls}
  viewBox={`0 0 ${wm.w} ${wm.h}`}
  role={label ? 'img' : undefined}
  aria-label={label ? 'CAPITAL' : undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
><path fill="currentColor" transform={`translate(${wm.tx} ${wm.ty})`} d={wm.d} /></svg>
