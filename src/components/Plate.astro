---
// Full-bleed photographic plate between sections, with the facade's vertical fin rules over it.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fins from './Fins.astro';
interface Props { src: ImageMetadata; alt: string; caption: string; position?: string }
const { src, alt, caption, position = '50% 50%' } = Astro.props;
---
<figure class="plate">
  <div class="plate__frame">
    <div class="plate__media" data-parallax="0.14">
      <Picture src={src} formats={['avif', 'webp']} widths={[640, 960, 1440, Math.min(1994, src.width)]} sizes="100vw" alt={alt} loading="lazy" decoding="async" style={`object-position:${position}`} />
    </div>
    <Fins class="plate__fins" />
  </div>
  <figcaption class="wrap plate__cap">{caption}</figcaption>
</figure>
<style>
  .plate {
    margin: 0;
    background: var(--night-900);
    padding-bottom: 1.25rem;
  }
  .plate__frame {
    position: relative;
    height: clamp(24rem, 78vh, 54rem);
    overflow: hidden;
  }
  .plate__media {
    position: absolute;
    inset: -12% 0;
    will-change: transform;
  }
  .plate__media :global(picture),
  .plate__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plate__frame :global(.plate__fins) {
    left: var(--gutter);
    right: auto;
  }
  .plate__cap {
    padding-top: 0.9rem;
    font-size: var(--step--1);
    color: var(--ink-on-night-2);
  }
</style>
